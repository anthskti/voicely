meta {
  name: Grade scene_02 (good takes)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/grade
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  scene_id: scene_02
  user_id: {{userId}}
  chunk_transcripts: This is the moment everything clicks.
  chunk_transcripts: One tap. Instant clarity.
  chunk_transcripts: Try it once, and you will not go back.
  reference_audio_urls: https://example.invalid/voicely-proto/scenes/scene_02/refs/chunk_00.wav
  reference_audio_urls: https://example.invalid/voicely-proto/scenes/scene_02/refs/chunk_01.wav
  reference_audio_urls: https://example.invalid/voicely-proto/scenes/scene_02/refs/chunk_02.wav
  @file(
    audio_chunks: ../../fixtures/audio/user_take_good_00.wav
  )
  @file(
    audio_chunks: ../../fixtures/audio/user_take_good_01.wav
  )
  @file(
    audio_chunks: ../../fixtures/audio/user_take_good_02.wav
  )
}

docs {
