meta {
  name: Grade scene_01 (good takes)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/grade
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  scene_id: {{sceneId}}
  user_id: {{userId}}
  chunk_transcripts: You cannot let her plant.
  chunk_transcripts: "Alright, I'm going in."
  chunk_transcripts: What about the hostile.
  chunk_transcripts: "I wouldn't worry bout her."
  chunk_transcripts: Are you certain?
  chunk_transcripts: One hundred, I got this.
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_00.wav
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_01.wav
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_02.wav
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_03.wav
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_04.wav
  reference_audio_urls: https://voicely-proto-0821.s3.us-east-2.amazonaws.com/scenes/scene_valorant/refs/chunk_05.wav
  audio_chunks: @file(../valorant/user_voice/Track1_VoiceAudio.wav)
  audio_chunks: @file(../valorant/user_voice/Track2_VoiceAudio.wav)
  audio_chunks: @file(../valorant/user_voice/Track3_VoiceAudio.wav)
  audio_chunks: @file(../valorant/user_voice/Track4_VoiceAudio.wav)
  audio_chunks: @file(../valorant/user_voice/Track5_VoiceAudio.wav)
  audio_chunks: @file(../valorant/user_voice/Track6_VoiceAudio.wav)
}

docs {
  Valorant scene: transcripts + public S3 ref slices; user takes from valorant/user_voice.
}
